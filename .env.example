# Local development environment for campaign-reach-system.
#
# Copy to `.env` (gitignored) and adjust as needed:
#   cp .env.example .env
#
# Load it into your shell before `./gradlew :app:bootRun`:
#   set -a; source .env; set +a
#
# `application.yml` ships no secret defaults — a missing value fails fast at
# startup, so every variable below must be present.

# --- docker compose: host port mappings -------------------------------------
# Override only if a default port is already taken on your machine. The app's
# DB_URL / KAFKA_BOOTSTRAP_SERVERS below must point at the same host ports.
POSTGRES_PORT=5432
KAFKA_PORT=9092
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
POSTGRES_DB=campaign_reach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- app: datasource (must match the compose postgres above) ----------------
DB_URL=jdbc:postgresql://localhost:5432/campaign_reach
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- app: kafka (must match the compose kafka above) ------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- app: email provider (no real key needed for local smoke testing) -------
EMAIL_PROVIDER_API_KEY=dummy-local-key

# --- app: local SMTP email provider (delivers to Mailpit, never to a real recipient)
# Enables the local-only SMTP EmailProviderClient that sends EMAIL reach mail to
# the Mailpit container from docker-compose instead of any external provider.
# Requires BOTH the `local` Spring profile AND mode=smtp-local to be active; in
# any other environment this wiring contributes nothing, so it can never leak
# mail. Mailpit captures every message locally — view them at
# http://localhost:8025 — and forwards to nobody. The recipient is a fixed
# local smoke-test inbox; the local.test domain marks these as non-real.
#
# Activates the `local` profile, which (together with mode below) wires the
# local SMTP provider. Without this the local mail config stays dormant.
SPRING_PROFILES_ACTIVE=local
# Selects the local SMTP provider path. Fed into application.yml's
# campaignreach.email-provider.mode placeholder (${EMAIL_PROVIDER_MODE:}).
EMAIL_PROVIDER_MODE=smtp-local
# SMTP host/port — must match the Mailpit SMTP port published by docker-compose
# (MAILPIT_SMTP_PORT above, default 1025). Fed into application.yml's
# campaignreach.email-provider.local.* placeholders.
LOCAL_SMTP_HOST=localhost
LOCAL_SMTP_PORT=1025
LOCAL_SMTP_FROM=campaign-reach@local.test
LOCAL_SMTP_RECIPIENT=local-inbox@local.test
LOCAL_SMTP_TIMEOUT=5s

# --- app: back-office operator account (HTTP Basic, OPERATOR role) ----------
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=operator-pass
OPERATOR_ID=00000000-0000-0000-0000-000000000001
