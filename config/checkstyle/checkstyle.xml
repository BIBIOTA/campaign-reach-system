<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Campaign-Reach Checkstyle configuration (design.md §11.3).

  This is a trimmed derivative of Checkstyle's bundled `google_checks.xml`.
  IMPORTANT: layout / formatting is owned exclusively by Spotless
  (Palantir Java Format, see campaignreach.java-conventions). To avoid two tools
  fighting over the same concern, ALL layout-class modules from google_checks
  are intentionally OMITTED here, namely:
    Indentation, LineLength, EmptyLineSeparator, OneStatementPerLine,
    SeparatorWrap*, NoLineWrap, *Whitespace* (WhitespaceAround, WhitespaceAfter,
    NoWhitespaceBefore, ParenPad, MethodParamPad, GenericWhitespace, ...),
    LeftCurly / RightCurly / NeedBraces (brace placement), OperatorWrap,
    EmptyLineSeparator, CommentsIndentation, FileTabCharacter, NewlineAtEndOfFile,
    SingleSpaceSeparator, Regexp* trailing-whitespace checks.

  What remains is strictly: naming, file/class structure, member visibility and
  Javadoc — the "non-format" half of google_checks. A violation fails the build
  (severity=error) per §11.3.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java, properties, xml"/>

    <!-- Excludes package-info.java files generated/owned elsewhere are still checked
         for Javadoc but module-info style is not used here. -->

    <module name="TreeWalker">

        <!-- ============ Naming conventions ============ -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="MethodName"/>
        <module name="ClassTypeParameterName">
            <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
        </module>
        <module name="InterfaceTypeParameterName">
            <property name="format" value="(^[A-Z][0-9]?)$|([A-Z][a-zA-Z0-9]*[T]$)"/>
        </module>
        <module name="ConstantName"/>
        <module name="StaticVariableName"/>
        <module name="CatchParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="RecordTypeParameterName"/>
        <module name="IllegalIdentifierName"/>
        <module name="AbbreviationAsWordInName">
            <property name="ignoreFinal" value="false"/>
            <property name="allowedAbbreviationLength" value="0"/>
            <property name="tokens" value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, ANNOTATION_FIELD_DEF,
                    PARAMETER_DEF, VARIABLE_DEF, METHOD_DEF, PATTERN_VARIABLE_DEF, RECORD_DEF, RECORD_COMPONENT_DEF"/>
            <property name="allowedAbbreviations" value="URL, JDBC, SQL, ID, API, DB"/>
        </module>

        <!-- ============ Imports / file structure ============ -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="OuterTypeNumber"/>
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>

        <!-- ============ Member visibility / coding structure ============ -->
        <module name="VisibilityModifier">
            <property name="allowPublicImmutableFields" value="true"/>
        </module>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="MissingOverride"/>
        <module name="MissingDeprecated"/>
        <module name="DeclarationOrder"/>
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
        <module name="FallThrough"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="EqualsHashCode"/>
        <module name="NoFinalizer"/>
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="DefaultComesLast"/>
        <module name="IllegalCatch"/>

        <!-- ============ Javadoc ============ -->
        <module name="InvalidJavadocPosition"/>
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
            <property name="allowedAnnotations" value="Override, Test, Bean"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="minLineCount" value="2"/>
            <property name="allowedAnnotations" value="Override, Test, Bean"/>
            <property name="tokens" value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
        </module>
        <module name="JavadocType"/>
        <module name="NonEmptyAtclauseDescription"/>
        <module name="JavadocContentLocationCheck"/>

        <!-- ============ Common bug-prone patterns ============ -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
    </module>
</module>
