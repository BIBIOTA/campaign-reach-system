<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter (design.md §11.3).

  Kept deliberately narrow: only excludes well-understood Spring/JPA framework
  false positives, never broad rule categories. `spotbugsMain` runs against
  production bytecode at effort=max, reportLevel=medium so High AND Normal
  (Medium-and-above) priority bugs fail the build.
-->
<FindBugsFilter>
    <!-- Spring injects configuration beans by reference; SpotBugs flags stored
         mutable references (EI_EXPOSE_REP*) on framework-managed config classes.
         These are not real defects in DI-managed singletons. -->
    <Match>
        <Class name="~.*\.config\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- JPA entities use protected no-arg constructors for Hibernate proxies and do not
         override finalize(), so the finalizer-attack vector in CT_CONSTRUCTOR_THROW does
         not apply. Constructor-level null checks are intentional domain invariants. The
         campaign aggregates live under `.domain.`; the reach orchestrator's activity-level
         reach_request entity (task 7.1) is a JPA entity in `reach.orchestrator` (reach has no
         `.domain.` package per its module layout), so it is matched explicitly here. -->
    <Match>
        <Class name="~.*\.domain\..*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.example.campaignreach.reach.orchestrator.ReachRequest"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- The paged audience expander (task 7.3) is a Spring @Component that stores injected framework
         collaborators (JdbcTemplate, PlatformTransactionManager) by reference, which is exactly how
         Spring DI hands them over. SpotBugs flags the stored mutable references (EI_EXPOSE_REP2), but
         these are DI-managed singletons, not defensively-copyable value objects — the same rationale
         as the config-class exclusion above. Scoped to this one FQN. -->
    <Match>
        <Class name="com.example.campaignreach.reach.orchestrator.PagedAudienceExpander"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
